# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Prelaunch access control
PRELAUNCH_MODE=false
PRELAUNCH_ALLOWED_EMAILS=

# Images
PEXELS_API_KEY=

# Automation + webhook security
CRON_SECRET=
WEBHOOK_SECRET=
ENCRYPTION_KEY=

# Billing / app URLs
APP_URL=
NEXT_PUBLIC_APP_URL=
PAYSERA_PROJECT_ID=
PAYSERA_SIGN_PASSWORD=
# Set to "off" to disable Paysera and grant full access to all features (dev/maintenance mode)
PAYSERA_ENABLED=on
BILLING_DEV_ACCESS=
NEXT_PUBLIC_BILLING_DEV_ACCESS=
FREE_MODE=

# Public site publishing
PUBLISHED_SITE_ROOT_DOMAIN=siroundchat.com
# Use `subdomain` only after wildcard DNS (*.your-domain) is pointed at this app.
PUBLISHED_SITE_URL_MODE=path

# Meta WhatsApp Cloud API
# Keep these server-side only. Do not expose them through NEXT_PUBLIC_ variables.
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
INSTAGRAM_API_URL=
INSTAGRAM_API_TOKEN=

# Twilio SMS alerts
# Keep TWILIO_AUTH_TOKEN secret and never commit it.
# Twilio trial accounts can only send to verified recipient numbers.
# Enable Kosovo (+383) in Twilio Geo Permissions before sending there.
# Trial SMS includes a Twilio trial prefix in the message body.
# Emojis and special Unicode characters can increase SMS segment cost.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# Development/testing fallback only when no business SMS alert phone is set.
RESTAURANT_OWNER_PHONE=
